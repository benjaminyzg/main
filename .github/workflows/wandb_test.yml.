name: Test W&B Connection

on:
  workflow_dispatch: # Allows you to run this test manually from the UI

# Recommended permission for security to allow checking out code
permissions:
  contents: read

jobs:
  test-connection:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v6 # Upgraded from v4 to v6 to resolve Node 20 deprecation

    - name: Set up Python
      uses: actions/setup-python@v6 # Upgraded from v5 to v6 to resolve Node 20 deprecation
      with:
        python-version: '3.10'

    - name: Install W&B
      run: pip install wandb

    - name: Verify W&B Login
      env:
        WANDB_API_KEY: ${{ secrets.WANDB_API_KEY }}
      run: |
        wandb login
