name: Test W&B Connection

on:
  workflow_dispatch: # Allows you to run this test manually from the UI

# Force the GitHub runner to execute Javascript actions using Node 24
env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: 'true'

permissions:
  contents: read

jobs:
  test-connection:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Install W&B
      run: pip install wandb

    - name: Verify W&B Login
      env:
        WANDB_API_KEY: ${{ secrets.WANDB_API_KEY }}
      run: |
        wandb login
